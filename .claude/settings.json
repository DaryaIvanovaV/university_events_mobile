{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(./gradlew.bat *)",
      "Bash(adb devices)",
      "Bash(adb logcat *)",
      "Bash(\"C:\\Users\\HuGox\\AppData\\Local\\Android\\Sdk/platform-tools/adb.exe\" devices)",
      "Bash(\"C:\\Users\\HuGox\\AppData\\Local\\Android\\Sdk/platform-tools/adb.exe\" logcat *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./build/**)",
      "Read(./app/build/**)",
      "Read(./.gradle/**)",
      "Read(./local.properties)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_verify.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
